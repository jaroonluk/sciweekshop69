# Copy to .env and adjust as needed:
#   cp .env.example .env

# --- App (Docker Compose) ---
SCI_APP_PORT=8088
SCI_PUBLIC_BASE_URL=http://localhost:8088

# --- MySQL / MariaDB ---
SCI_DB_NAME=sciweekshop
SCI_DB_USER=sci
SCI_DB_PASS=sci
MYSQL_ROOT_PASSWORD=rootpass
SCI_DB_PUBLISH_PORT=3308
SCI_EOFFICE_DB=eoffice
SCI_AUTO_SCHEMA=1

# --- Google OAuth (Admin login) ---
# Register redirect URI: http://localhost:8080/auth_callback.php
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails allowed to bootstrap as admin on first login
SCI_ALLOWED_EMAILS=
SCI_ALLOWED_DOMAINS=

# --- MinIO / S3 ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_INSECURE_SKIP_VERIFY=true
MINIO_ACCESS_KEY=sciadmin
MINIO_SECRET_KEY=scipassword
MINIO_BUCKET=sci-shop
MINIO_PUBLISH_PORT=9000
MINIO_CONSOLE_PORT=9001
